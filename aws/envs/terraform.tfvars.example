# Environment Configuration
# Copy this file to your environment directory as terraform.tfvars
# and update with your actual values.

env    = "dev" # Environment name: dev, prod
region = "us-east-1"

# AWS named profile for provider auth. Required when using `aws sso login` /
# AWS Identity Center, unless you `export AWS_PROFILE=<name>` in the shell first.
# Leave commented out to use the default credential chain.
# aws_profile = "default"

tags = {
  organization = "my-org" # Your organization name
  project      = "my-project"
}

# ========================================
# VPC Network Configuration
# ========================================
# The `vpcs` variable supports multiple VPCs with subnets, NAT gateways,
# and security groups. Each VPC is a self-contained configuration object.
#
# Routing behaviour:
#   - Public subnets (public = true) → shared public route table (0.0.0.0/0 → IGW)
#   - Private subnets with nat_gateway_name → private route table (0.0.0.0/0 → NAT GW)
#   - Private subnets without nat_gateway_name → VPC default route table (isolated)

vpcs = [
  # Example 1: HA multi-AZ VPC with public/private subnets and NAT
  {
    name       = "main-vpc"
    cidr_block = "10.0.0.0/16"

    subnets = [
      # Public subnets — one per AZ for ALB/NLB placement
      {
        name              = "public-1a"
        cidr_block        = "10.0.1.0/24"
        availability_zone = "us-east-1a"
        public            = true
      },
      {
        name              = "public-1b"
        cidr_block        = "10.0.2.0/24"
        availability_zone = "us-east-1b"
        public            = true
      },

      # Private subnets — application tier with NAT egress
      {
        name              = "app-1a"
        cidr_block        = "10.0.10.0/24"
        availability_zone = "us-east-1a"
        nat_gateway_name  = "nat-1a"
      },
      {
        name              = "app-1b"
        cidr_block        = "10.0.11.0/24"
        availability_zone = "us-east-1b"
        nat_gateway_name  = "nat-1b"
      },

      # Private subnets — database tier (isolated, no internet access)
      {
        name              = "db-1a"
        cidr_block        = "10.0.20.0/24"
        availability_zone = "us-east-1a"
      },
      {
        name              = "db-1b"
        cidr_block        = "10.0.21.0/24"
        availability_zone = "us-east-1b"
      },
    ]

    # NAT gateways — one per AZ for HA (must reference public subnets)
    nat_gateways = [
      { name = "nat-1a", subnet_name = "public-1a" },
      { name = "nat-1b", subnet_name = "public-1b" },
    ]

    security_groups = [
      {
        name        = "web-sg"
        description = "Allow HTTP/HTTPS from the internet"
        ingress_rules = [
          { from_port = 80, to_port = 80, protocol = "tcp", cidr_blocks = ["0.0.0.0/0"] },
          { from_port = 443, to_port = 443, protocol = "tcp", cidr_blocks = ["0.0.0.0/0"] },
        ]
        egress_rules = [
          { from_port = 0, to_port = 0, protocol = "-1", cidr_blocks = ["0.0.0.0/0"] },
        ]
      },
      {
        name        = "app-sg"
        description = "Allow traffic from web tier"
        ingress_rules = [
          { from_port = 8080, to_port = 8080, protocol = "tcp", cidr_blocks = ["10.0.1.0/24", "10.0.2.0/24"] },
        ]
        egress_rules = [
          { from_port = 0, to_port = 0, protocol = "-1", cidr_blocks = ["0.0.0.0/0"] },
        ]
      },
      {
        name        = "db-sg"
        description = "Allow database connections from app tier"
        ingress_rules = [
          { from_port = 5432, to_port = 5432, protocol = "tcp", cidr_blocks = ["10.0.10.0/24", "10.0.11.0/24"] },
        ]
        egress_rules = [
          { from_port = 0, to_port = 0, protocol = "-1", cidr_blocks = ["0.0.0.0/0"] },
        ]
      },
    ]
  },

  # Example 2: Simple VPC (single public subnet, no NAT)
  # Useful for bastion hosts, dev environments, or standalone services
  # {
  #   name       = "simple-vpc"
  #   cidr_block = "172.16.0.0/16"
  #
  #   subnets = [
  #     {
  #       name              = "public-1a"
  #       cidr_block        = "172.16.1.0/24"
  #       availability_zone = "us-east-1a"
  #       public            = true
  #     },
  #   ]
  #
  #   security_groups = [
  #     {
  #       name        = "allow-ssh"
  #       description = "Allow SSH access"
  #       ingress_rules = [
  #         { from_port = 22, to_port = 22, protocol = "tcp", cidr_blocks = ["YOUR_IP/32"] },
  #       ]
  #       egress_rules = [
  #         { from_port = 0, to_port = 0, protocol = "-1", cidr_blocks = ["0.0.0.0/0"] },
  #       ]
  #     },
  #   ]
  # }
]

# ========================================
# IAM: EC2 instance profiles + Lambda execution roles
# ========================================
# Each entry under ec2_instance_profiles creates one IAM role and one
# instance profile of the same name, with the listed managed policies attached.
# Reference the profile name from instances[*].iam_instance_profile.

ec2_instance_profiles = [
  # {
  #   name = "ec2-ssm"
  #   description = "EC2 instance profile with SSM Managed Instance Core"
  #   managed_policy_arns = [
  #     "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore",
  #   ]
  # },
]

lambda_execution_roles = [
  # {
  #   name = "lambda-basic-execution"
  #   managed_policy_arns = [
  #     "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
  #   ]
  # },
]

# ========================================
# EC2 / Compute
# ========================================
# `os` triggers an AMI lookup (debian-12, al2023, ubuntu-22). Or set `ami_id` directly.
# `subnet_name` and `security_group_names` use network module keys: "vpc-name/subnet-name".

key_pairs = [
  # { name = "my-key", public_key = "ssh-ed25519 AAAA..." },
]

instances = [
  # {
  #   name                 = "app-1"
  #   os                   = "debian-12"
  #   instance_type        = "t3.micro"
  #   subnet_name          = "main-vpc/public-1a"
  #   security_group_names = ["main-vpc/web-sg"]
  #   key_name             = "my-key"
  #   iam_instance_profile = "ec2-ssm"
  #   eip                  = true
  #   root_volume = { size_gb = 30, type = "gp3" }
  # },
]

# ========================================
# RDS
# ========================================
# Master password is randomly generated and written to SSM Parameter Store at
# `ssm_password_path` (default: /<name>/master_password). DB subnet group needs
# subnets in at least 2 AZs.

rds_instances = [
  # {
  #   name              = "appdb"
  #   engine            = "postgres"  # postgres | mysql | mariadb
  #   engine_version    = "16.4"
  #   instance_class    = "db.t4g.micro"
  #   allocated_storage = 20
  #   db_name           = "app"
  #   username          = "app"
  #   subnet_names = [
  #     "main-vpc/db-1a",
  #     "main-vpc/db-1b",
  #   ]
  #   security_group_names = ["main-vpc/db-sg"]
  #   publicly_accessible = false
  #   skip_final_snapshot = true
  # },
]

# ========================================
# Lambda
# ========================================
# Source code is zipped from a local directory relative to the env dir.
# Create envs/<env>/lambda-src/ with handler.py (or other runtime entrypoint).

lambda_functions = [
  # {
  #   name       = "hello"
  #   runtime    = "python3.12"
  #   handler    = "handler.lambda_handler"
  #   source_dir = "lambda-src"
  #   role_name  = "lambda-basic-execution"
  #   function_url = { enabled = true, auth_type = "AWS_IAM" }
  # },
]

# ========================================
# AWS Budgets
# ========================================
# `time_unit` supports DAILY / MONTHLY / QUARTERLY / ANNUALLY.
# Subscribers get a one-time "Confirm subscription" email — click it before
# notifications start firing.

budgets = [
  # {
  #   name         = "daily-cost-alert"
  #   limit_amount = "0.5"
  #   time_unit    = "DAILY"
  #   notifications = [
  #     {
  #       threshold                  = 100  # PERCENTAGE of limit_amount
  #       notification_type          = "ACTUAL"
  #       subscriber_email_addresses = ["you@example.com"]
  #     },
  #   ]
  # },
]
