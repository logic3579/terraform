# Environment Configuration
# Copy this file to terraform.tfvars and update with your actual values

env = "test"  # Environment name: dev, test, devtest, uat, prod

labels = {
  organization = "my-org"          # Your organization name
}

project_id = "my-project"          # GCP Project ID
region     = "asia-southeast1"     # Default region
zone       = "asia-southeast1-a"   # Default zone

# ========================================
# VPC Networks Configuration
# ========================================
# The `networks` variable supports multiple VPCs with their subnets and firewalls.
# Each network is a self-contained configuration object.

networks = [
  # Example 1: Primary VPC with subnets and firewalls
  {
    name = "my-project-vpc"
    subnets = [
      {
        name   = "database-subnet"
        cidr   = "10.0.0.0/24"
        region = "asia-southeast1"
      },
      {
        name   = "app-subnet"
        cidr   = "10.0.1.0/24"
        region = "asia-southeast1"
      },
      {
        name   = "web-subnet"
        cidr   = "10.0.2.0/24"
        region = "asia-southeast1"
      },
      # Multi-region subnet example
      {
        name   = "us-subnet"
        cidr   = "10.1.0.0/24"
        region = "us-central1"
      }
    ]
    firewalls = [
      {
        name        = "my-project-vpc-allow-ssh"
        description = "Allow SSH access via IAP"
        direction   = "INGRESS"
        priority    = 1000
        source_ranges = [
          "35.235.240.0/20", # GCP IAP
        ]
        target_tags = ["ssh-enabled"]
        allow = [
          {
            protocol = "tcp"
            ports    = ["22"]
          }
        ]
      },
      {
        name          = "my-project-vpc-allow-http-https"
        description   = "Allow HTTP and HTTPS traffic"
        direction     = "INGRESS"
        priority      = 1000
        source_ranges = ["0.0.0.0/0"]
        target_tags   = ["web-server"]
        allow = [
          {
            protocol = "tcp"
            ports    = ["80", "443"]
          }
        ]
      },
      {
        name          = "my-project-vpc-allow-internal"
        description   = "Allow internal communication"
        direction     = "INGRESS"
        priority      = 65534
        source_ranges = ["10.0.0.0/8"] # Internal network range
        allow = [
          {
            protocol = "tcp"
            ports    = ["0-65535"]
          },
          {
            protocol = "udp"
            ports    = ["0-65535"]
          },
          {
            protocol = "icmp"
          }
        ]
      }
    ]
  },

  # Example 2: Secondary VPC (empty, no subnets or firewalls)
  # Useful for peering or isolated networks
  # {
  #   name      = "my-project-secondary-vpc"
  #   subnets   = []
  #   firewalls = []
  # }
]

# ========================================
# Cloud NAT Configuration
# ========================================
# NAT configurations reference VPCs by name from the `networks` variable.
#
# Port Allocation Modes:
# 1. Static (default): Fixed port allocation per VM
#    - enable_dynamic_port_allocation = false
#    - min_ports_per_vm: 64-65536 (default: 64)
#
# 2. Dynamic: Ports allocated dynamically based on usage (recommended for variable workloads)
#    - enable_dynamic_port_allocation = true
#    - min_ports_per_vm: must be power of 2, 32-32768 (default: 32)
#    - max_ports_per_vm: upper limit for dynamic allocation
#    - Note: Cannot be used with enable_endpoint_independent_mapping = true

nats = [
  # Example 1: Static port allocation (default)
  {
    name                               = "my-project-nat"
    router_name                        = "my-project-router"
    network                            = "my-project-vpc" # Must match a network name above
    region                             = "asia-southeast1"
    source_subnetwork_ip_ranges_to_nat = "ALL_SUBNETWORKS_ALL_IP_RANGES"
    nat_ip_allocate_option             = "AUTO_ONLY" # or "MANUAL_ONLY" for static IP

    # Static port allocation (default)
    enable_dynamic_port_allocation      = false
    min_ports_per_vm                    = 64
    enable_endpoint_independent_mapping = false

    log_config = {
      enable = false
      filter = "ERRORS_ONLY" # Options: ERRORS_ONLY, TRANSLATIONS_ONLY, ALL
    }
  },
  # Example 2: Dynamic port allocation (recommended for variable workloads)
  # {
  #   name                               = "my-project-nat-dpa"
  #   router_name                        = "my-project-router-dpa"
  #   network                            = "my-project-vpc"
  #   region                             = "asia-southeast1"
  #   source_subnetwork_ip_ranges_to_nat = "ALL_SUBNETWORKS_ALL_IP_RANGES"
  #   nat_ip_allocate_option             = "AUTO_ONLY"
  #
  #   # Dynamic port allocation - ports are allocated based on actual usage
  #   enable_dynamic_port_allocation      = true
  #   min_ports_per_vm                    = 32    # Must be power of 2 (32-32768)
  #   max_ports_per_vm                    = 65536 # Upper limit for dynamic allocation
  #   enable_endpoint_independent_mapping = false # Cannot be true when DPA is enabled
  #
  #   log_config = {
  #     enable = true
  #     filter = "ALL"
  #   }
  # }
]

# ========================================
# IAM - Service Accounts
# ========================================

service_accounts = [
  {
    account_id   = "app-sa"
    display_name = "Application Service Account"
    description  = "Service account for application workloads"
  },
  {
    account_id   = "web-sa"
    display_name = "Web Server Service Account"
    description  = "Service account for web-server workloads"
  },
  # Example: Service account for GKE Workload Identity
  # {
  #   account_id   = "argocd-cluster-access"
  #   display_name = "ArgoCD Cluster Access"
  #   description  = "Service Account for ArgoCD to access GKE clusters via Workload Identity"
  # }
]
iam_bindings = [
  {
    service_account_email = "app-sa@my-project.iam.gserviceaccount.com"
    roles = [
      "roles/storage.objectViewer",
    ]
  },
  {
    service_account_email = "web-sa@my-project.iam.gserviceaccount.com"
    roles = [
      "roles/storage.objectViewer",
    ]
  },
  # Example: IAM binding for GKE access
  # {
  #   service_account_email = "argocd-cluster-access@my-project.iam.gserviceaccount.com"
  #   roles = [
  #     "roles/container.developer",
  #   ]
  # }
]

# ========================================
# GKE Workload Identity Bindings
# ========================================
# Allow Kubernetes Service Accounts (KSA) to impersonate Google Service Accounts (GSA).
# Prerequisites:
#   1. GKE cluster must have Workload Identity enabled:
#      gcloud container clusters update CLUSTER_NAME --workload-pool=PROJECT_ID.svc.id.goog
#   2. KSA must be annotated with the GSA email:
#      kubectl annotate serviceaccount KSA_NAME \
#        --namespace NAMESPACE \
#        iam.gke.io/gcp-service-account=GSA_NAME@PROJECT_ID.iam.gserviceaccount.com

workload_identity_bindings = [
  # Example: Allow ArgoCD application controller to impersonate GSA
  # {
  #   service_account_id = "argocd-cluster-access"         # GSA account_id (must exist in service_accounts)
  #   namespace          = "argocd"                        # Kubernetes namespace
  #   ksa_name           = "argocd-application-controller" # Kubernetes Service Account name
  #   wi_pool_project_id = "gke-cluster-project"           # Required: project ID where GKE cluster resides
  # }
]

# ========================================
# Cloud Storage Buckets
# ========================================

buckets = [
  {
    name                     = "app-test-bucket"
    location                 = "asia-southeast1"
    storage_class            = "STANDARD"
    public_access_prevention = "enforced"
    versioning_enabled       = true
    lifecycle_rules = [
      {
        action    = { type = "SetStorageClass", storage_class = "NEARLINE" }
        condition = { age = 30 }
      },
      {
        action    = { type = "SetStorageClass", storage_class = "COLDLINE" }
        condition = { age = 90 }
      },
      {
        action    = { type = "Delete" }
        condition = { age = 365 }
      },
      # Example: Delete objects under a specific prefix after 7 days
      {
        action    = { type = "Delete" }
        condition = { age = 7, matches_prefix = ["tmp/", "staging/"] }
      }
    ]

    # Bucket-level IAM bindings (non-authoritative, won't overwrite existing permissions)
    # Supports: serviceAccount, user, group, domain principals
    # iam_bindings = [
    #   {
    #     role = "roles/storage.objectViewer"
    #     members = [
    #       "serviceAccount:my-sa@my-project.iam.gserviceaccount.com",
    #       "user:alice@example.com",
    #     ]
    #   },
    #   # Cross-project service account access
    #   {
    #     role = "roles/storage.objectAdmin"
    #     members = [
    #       "serviceAccount:123456789-compute@developer.gserviceaccount.com",
    #     ]
    #   },
    # ]
  }
]

# ========================================
# Compute Engine - VM Instances
# ========================================
# Instances reference VPCs and subnets by name.
#
# All instances are initialized using cloud-init.
# Cloud-init configuration:
#   - Configurable packages (defaults: htop, net-tools, iputils-ping)
#   - Support for additional cloud-init YAML via additional_config
#
# To enable cloud-init:
#   cloud_init = {
#     enabled           = true
#     packages          = ["vim", "git"]  # Optional, additional packages
#     additional_config = "..."           # Optional, additional cloud-init YAML
#   }

instances = [
  {
    name                   = "app-server-1"
    machine_type           = "e2-custom-1-2048"
    region                 = "asia-southeast1"
    zone                   = "asia-southeast1-b"
    network_tags           = ["app-server", "ssh-enabled"]
    external_ip            = false # Private instance
    image_family           = "ubuntu-2404-lts-amd64"
    image_project          = "ubuntu-os-cloud"
    disk_size              = 50
    disk_type              = "pd-standard"
    network                = "my-project-vpc" # Must match a network name
    subnetwork             = "app-subnet"     # Must match a subnet name in the network
    service_account_scopes = ["https://www.googleapis.com/auth/cloud-platform"] # Custom service account scopes
    preemptible            = false # Optional, default: false
    deletion_protection    = true # Optional, default: false

    # Cloud-init enabled
    cloud_init = {
      enabled = true
    }

    # Additional disks
    additional_disks = [
      {
        name = "app-server-1-data"
        size = 100
        type = "pd-ssd"
      },
      # Example: Attach an existing disk (read-only)
      # {
      #   name     = "shared-data-disk"
      #   existing = true
      #   mode     = "READ_ONLY"
      # }
    ]
  },
  # Example: Instance with custom packages and additional config
  {
    name          = "custom-server"
    machine_type  = "e2-medium"
    region        = "asia-southeast1"
    zone          = "asia-southeast1-c"
    network_tags  = ["app-server", "ssh-enabled"]
    external_ip   = false
    image_family  = "ubuntu-2404-lts-amd64"
    image_project = "ubuntu-os-cloud"
    disk_size     = 50
    disk_type     = "pd-standard"
    network       = "my-project-vpc"
    subnetwork    = "app-subnet"

    # Cloud-init with custom packages and additional configuration
    cloud_init = {
      enabled = true
      packages = [
        "vim",
        "git",
        "jq"
      ]
      additional_config = <<-EOT
        # Additional custom configuration
        runcmd:
          - echo "Custom initialization complete" > /var/log/init-complete.txt
      EOT
    }
  },
  # Example: Instance with or without Docker
  {
    name          = "web-server"
    machine_type  = "e2-micro"
    region        = "asia-southeast1"
    zone          = "asia-southeast1-a"
    network_tags  = ["app-server", "ssh-enabled"]
    external_ip   = false
    image_family  = "ubuntu-2404-lts-amd64"
    image_project = "ubuntu-os-cloud"
    disk_size     = 20
    disk_type     = "pd-standard"
    network       = "my-project-vpc"
    subnetwork    = "app-subnet"

    # Cloud-init configuration
    cloud_init = {
      enabled = true
      packages = [
        "nodejs",
        "nginx"
      ]
    }
  },
]

# ========================================
# Instance Groups
# ========================================

instance_groups = [
  {
    name        = "web-servers-group-a"
    description = "Instance group for web servers in zone a"
    zone        = "asia-southeast1-a"
    instances   = ["web-server-1"]
    named_ports = [
      { name = "http", port = 80 },
      { name = "https", port = 443 }
    ]
  },
  {
    name        = "app-servers-group-b"
    description = "Instance group for app servers in zone b"
    zone        = "asia-southeast1-b"
    instances   = ["app-server-1"]
    named_ports = [
      { name = "api-1", port = 8000 },
      { name = "api-2", port = 8080 }
    ]
  }
]

# ========================================
# Load Balancers
# ========================================

load_balancers = [
  # Example 1: HTTP + HTTPS Load Balancer with managed SSL
  {
    name                = "web-lb"
    description         = "Load balancer for web traffic"
    global_address_name = "web-lb-ip"
    http_port           = 80
    https_port          = 443

    health_check = {
      name                = "web-health-check"
      check_interval_sec  = 10
      timeout_sec         = 5
      healthy_threshold   = 2
      unhealthy_threshold = 3
      port                = 80
    }

    backend_service = {
      name             = "web-backend"
      protocol         = "HTTP"
      port_name        = "http"
      timeout_sec      = 30
      enable_cdn       = false
      session_affinity = "CLIENT_IP" # Options: NONE, CLIENT_IP, CLIENT_IP_PROTO
      security_policy  = null        # Cloud Armor policy name (optional)
      enable_logging   = false
      log_sample_rate  = 0.5

      # Choose one balancing mode:
      # Option 1: RATE-based
      balancing_mode        = "RATE"
      max_rate_per_instance = 1000

      # Option 2: UTILIZATION-based (uncomment to use)
      # balancing_mode  = "UTILIZATION"
      # max_utilization = 0.8

      instance_groups = [
        "web-servers-group-a"
      ]
    }

    ssl_config = {
      enabled             = true
      certificate_domains = ["www.example.com"] # GCP-managed certificate
      # For self-managed certificates:
      # private_key  = file("path/to/key.pem")
      # certificate  = file("path/to/cert.pem")
    }
  },

  # Example 2: HTTP-only Load Balancer on custom port
  {
    name                = "api-lb"
    description         = "Load balancer for API traffic"
    global_address_name = "web-lb-ip" # Can share the same IP
    http_port           = 8000

    health_check = {
      name                = "api-health-check"
      check_interval_sec  = 5
      timeout_sec         = 5
      healthy_threshold   = 2
      unhealthy_threshold = 2
      port                = 8000
    }

    backend_service = {
      name             = "api-backend"
      protocol         = "HTTP"
      port_name        = "api-1"
      timeout_sec      = 60
      enable_cdn       = false
      session_affinity = "NONE"
      security_policy  = null
      enable_logging   = false
      log_sample_rate  = 0.1

      balancing_mode  = "UTILIZATION"
      max_utilization = 0.8

      instance_groups = [
        "app-servers-group-b"
      ]
    }
  }
]

# ========================================
# NEG-based Load Balancers (GKE Standalone NEGs)
# ========================================
# For GKE services exposed via Standalone NEGs.
#
# Setup flow:
# 1. Deploy K8s Service with cloud.google.com/neg annotation (Helm charts)
# 2. GKE NEG controller creates zonal NEGs automatically
# 3. List NEGs: gcloud compute network-endpoint-groups list
# 4. Populate neg names/zones below, then terraform apply

neg_load_balancers = [
  # Example 1: HTTP + HTTPS NEG Load Balancer with managed SSL
  {
    name                = "gke-web-lb"
    description         = "Load balancer for GKE web service"
    global_address_name = "gke-web-lb-ip"
    http_port           = 80
    https_port          = 443

    health_check = {
      name                = "gke-web-health-check"
      type                = "HTTP"
      check_interval_sec  = 15
      timeout_sec         = 5
      healthy_threshold   = 2
      unhealthy_threshold = 3
      port                = 8080
      request_path        = "/healthz"
    }

    backend_service = {
      name             = "gke-web-backend"
      protocol         = "HTTP"
      timeout_sec      = 30
      enable_cdn       = false
      session_affinity = "NONE"
      balancing_mode   = "RATE"
      max_rate_per_endpoint = 1000
      enable_logging   = true
      log_sample_rate  = 0.5

      # NEG name + zone pairs from: gcloud compute network-endpoint-groups list
      negs = [
        { name = "k8s1-abcdef-default-web-svc-8080-abcdef", zone = "asia-southeast1-a" },
        { name = "k8s1-abcdef-default-web-svc-8080-abcdef", zone = "asia-southeast1-b" },
      ]
    }

    ssl_config = {
      enabled             = true
      certificate_domains = ["app.example.com"]
    }
  },

  # Example 2: HTTP-only NEG Load Balancer (API service)
  # {
  #   name                = "gke-api-lb"
  #   description         = "Load balancer for GKE API service"
  #   global_address_name = "gke-api-lb-ip"
  #   http_port           = 80
  #
  #   health_check = {
  #     name         = "gke-api-health-check"
  #     type         = "HTTP"
  #     port         = 8080
  #     request_path = "/health"
  #   }
  #
  #   backend_service = {
  #     name           = "gke-api-backend"
  #     protocol       = "HTTP"
  #     timeout_sec    = 60
  #     balancing_mode = "RATE"
  #     max_rate_per_endpoint = 500
  #
  #     negs = [
  #       { name = "k8s1-abcdef-default-api-svc-8080-ghijkl", zone = "asia-southeast1-a" },
  #       { name = "k8s1-abcdef-default-api-svc-8080-ghijkl", zone = "asia-southeast1-b" },
  #     ]
  #   }
  # }
]

# ========================================
# GKE Clusters
# ========================================
# Supports Autopilot (fully managed) and Standard (user-managed node pools).
#
# Autopilot: set enable_autopilot = true, no node_pools needed.
# Standard:  set enable_autopilot = false, define at least one node_pool.
#
# Prerequisites:
#   - VPC and subnets must exist (define in `networks` above)
#   - For private clusters, ensure Cloud NAT is configured for outbound access
#   - For Workload Identity, annotate KSAs after cluster creation:
#     kubectl annotate serviceaccount KSA_NAME \
#       --namespace NAMESPACE \
#       iam.gke.io/gcp-service-account=GSA_NAME@PROJECT_ID.iam.gserviceaccount.com

gke_clusters = [
  # Example 1: Autopilot cluster (recommended for most workloads)
  {
    name             = "my-project-autopilot"
    location         = "asia-southeast1" # Regional cluster
    enable_autopilot = true

    # Version & release channel
    release_channel = "REGULAR"

    # Networking — must reference existing VPC/subnet
    network    = "my-project-vpc"
    subnetwork = "app-subnet"

    # VPC-native IP allocation
    ip_allocation_policy = {
      cluster_ipv4_cidr_block  = "/14" # Auto-create pod range
      services_ipv4_cidr_block = "/20" # Auto-create service range
    }

    # Private cluster — nodes have no public IPs
    private_cluster_config = {
      enable_private_nodes    = true
      enable_private_endpoint = false            # false = master reachable from authorized networks
      master_ipv4_cidr_block  = "172.16.0.0/28"  # /28 required for master VPC peering
    }

    # Restrict API server access
    master_authorized_networks = [
      { display_name = "office-vpn", cidr_block = "203.0.113.0/24" },
      { display_name = "cloud-shell", cidr_block = "35.235.240.0/20" },
    ]

    # DNS
    dns_config = {
      cluster_dns       = "CLOUD_DNS"
      cluster_dns_scope = "CLUSTER_SCOPE"
    }

    # Gateway API
    gateway_api_config = {
      channel = "CHANNEL_STANDARD"
    }

    # Maintenance: weekends 1:00-9:00 UTC
    maintenance_policy = {
      start_time = "2024-01-01T01:00:00Z"
      end_time   = "2024-01-01T09:00:00Z"
      recurrence = "FREQ=WEEKLY;BYDAY=SA,SU"
    }

    # Logging & monitoring
    logging_enabled_components               = ["SYSTEM_COMPONENTS", "WORKLOADS"]
    monitoring_enabled_components             = ["SYSTEM_COMPONENTS"]
    monitoring_enable_managed_prometheus = true

    # Security
    workload_identity_enabled = true
    security_posture_config = {
      mode               = "BASIC"
      vulnerability_mode = "BASIC"
    }

    deletion_protection = true
  },

  # Example 2: Standard cluster with custom node pools
  # {
  #   name             = "my-project-standard"
  #   location         = "asia-southeast1"
  #   enable_autopilot = false
  #
  #   release_channel   = "REGULAR"
  #   datapath_provider = "ADVANCED_DATAPATH" # Dataplane V2 (eBPF, built-in NetworkPolicy)
  #
  #   network    = "my-project-vpc"
  #   subnetwork = "app-subnet"
  #
  #   ip_allocation_policy = {
  #     cluster_ipv4_cidr_block  = "/14"
  #     services_ipv4_cidr_block = "/20"
  #   }
  #
  #   private_cluster_config = {
  #     enable_private_nodes    = true
  #     enable_private_endpoint = false
  #     master_ipv4_cidr_block  = "172.16.1.0/28"
  #   }
  #
  #   master_authorized_networks = [
  #     { display_name = "office-vpn", cidr_block = "203.0.113.0/24" },
  #   ]
  #
  #   dns_config = {
  #     cluster_dns       = "CLOUD_DNS"
  #     cluster_dns_scope = "CLUSTER_SCOPE"
  #   }
  #
  #   maintenance_policy = {
  #     start_time = "2024-01-01T01:00:00Z"
  #     end_time   = "2024-01-01T09:00:00Z"
  #     recurrence = "FREQ=WEEKLY;BYDAY=SA,SU"
  #   }
  #
  #   # Addons (Standard only)
  #   addons_config = {
  #     http_load_balancing_disabled        = false
  #     horizontal_pod_autoscaling_disabled = false
  #     gce_persistent_disk_csi_enabled     = true
  #     gcs_fuse_csi_enabled                = true
  #     dns_cache_enabled                   = true
  #     config_connector_enabled            = false
  #   }
  #
  #   workload_identity_enabled = true
  #   deletion_protection       = true
  #
  #   # Node pools (required for Standard clusters)
  #   node_pools = [
  #     # General-purpose pool
  #     {
  #       name               = "general"
  #       machine_type       = "e2-standard-4"
  #       disk_size_gb       = 100
  #       disk_type          = "pd-balanced"
  #       image_type         = "COS_CONTAINERD"
  #       initial_node_count = 1
  #       min_node_count     = 1
  #       max_node_count     = 5
  #       auto_repair        = true
  #       auto_upgrade       = true
  #       labels = {
  #         pool = "general"
  #       }
  #     },
  #     # Spot pool for batch/non-critical workloads
  #     {
  #       name               = "spot-workers"
  #       machine_type       = "e2-standard-4"
  #       disk_size_gb       = 50
  #       disk_type          = "pd-standard"
  #       spot               = true
  #       initial_node_count = 0
  #       min_node_count     = 0
  #       max_node_count     = 10
  #       labels = {
  #         pool = "spot"
  #       }
  #       taints = [
  #         { key = "cloud.google.com/gke-spot", value = "true", effect = "NO_SCHEDULE" }
  #       ]
  #     },
  #     # GPU pool (optional)
  #     # {
  #     #   name               = "gpu-pool"
  #     #   machine_type       = "n1-standard-4"
