# Environment Configuration
# Copy this file to terraform.tfvars and update with your actual values

env = "test"  # Environment name: dev, test, devtest, uat, prod

labels = {
  organization = "my-org"          # Your organization name
}

project_id = "my-project"          # GCP Project ID
region     = "asia-southeast1"     # Default region
zone       = "asia-southeast1-a"   # Default zone

# ========================================
# VPC Networks Configuration
# ========================================
# The `networks` variable supports multiple VPCs with their subnets and firewalls.
# Each network is a self-contained configuration object.

networks = [
  # Example 1: Primary VPC with subnets and firewalls
  {
    name = "my-project-vpc"
    subnets = [
      {
        name   = "database-subnet"
        cidr   = "10.0.0.0/24"
        region = "asia-southeast1"
      },
      {
        name   = "app-subnet"
        cidr   = "10.0.1.0/24"
        region = "asia-southeast1"
      },
      {
        name   = "web-subnet"
        cidr   = "10.0.2.0/24"
        region = "asia-southeast1"
      },
      # Multi-region subnet example
      {
        name   = "us-subnet"
        cidr   = "10.1.0.0/24"
        region = "us-central1"
      }
    ]
    firewalls = [
      {
        name        = "my-project-vpc-allow-ssh"
        description = "Allow SSH access via IAP"
        direction   = "INGRESS"
        priority    = 1000
        source_ranges = [
          "35.235.240.0/20", # GCP IAP
        ]
        target_tags = ["ssh-enabled"]
        allow = [
          {
            protocol = "tcp"
            ports    = ["22"]
          }
        ]
      },
      {
        name          = "my-project-vpc-allow-http-https"
        description   = "Allow HTTP and HTTPS traffic"
        direction     = "INGRESS"
        priority      = 1000
        source_ranges = ["0.0.0.0/0"]
        target_tags   = ["web-server"]
        allow = [
          {
            protocol = "tcp"
            ports    = ["80", "443"]
          }
        ]
      },
      {
        name          = "my-project-vpc-allow-internal"
        description   = "Allow internal communication"
        direction     = "INGRESS"
        priority      = 65534
        source_ranges = ["10.0.0.0/8"] # Internal network range
        allow = [
          {
            protocol = "tcp"
            ports    = ["0-65535"]
          },
          {
            protocol = "udp"
            ports    = ["0-65535"]
          },
          {
            protocol = "icmp"
          }
        ]
      }
    ]
  },

  # Example 2: Secondary VPC (empty, no subnets or firewalls)
  # Useful for peering or isolated networks
  # {
  #   name      = "my-project-secondary-vpc"
  #   subnets   = []
  #   firewalls = []
  # }
]

# ========================================
# Cloud NAT Configuration
# ========================================
# NAT configurations reference VPCs by name from the `networks` variable.

nats = [
  {
    name                                = "my-project-nat"
    router_name                         = "my-project-router"
    network                             = "my-project-vpc" # Must match a network name above
    region                              = "asia-southeast1"
    source_subnetwork_ip_ranges_to_nat  = "ALL_SUBNETWORKS_ALL_IP_RANGES"
    nat_ip_allocate_option              = "AUTO_ONLY" # or "MANUAL_ONLY" for static IP
    min_ports_per_vm                    = 64
    max_ports_per_vm                    = 65536
    enable_endpoint_independent_mapping = false
    log_config = {
      enable = false
      filter = "ERRORS_ONLY" # Options: ERRORS_ONLY, TRANSLATIONS_ONLY, ALL
    }
  }
]

# ========================================
# IAM - Service Accounts
# ========================================

service_accounts = [
  {
    account_id   = "app-sa"
    display_name = "Application Service Account"
    description  = "Service account for application workloads"
  },
  {
    account_id   = "web-sa"
    display_name = "Web Server Service Account"
    description  = "Service account for web-server workloads"
  },
]
iam_bindings = [
  {
    service_account_email = "app-sa@my-project.iam.gserviceaccount.com"
    roles = [
      "roles/storage.objectViewer",
    ]
  },
  {
    service_account_email = "web-sa@my-project.iam.gserviceaccount.com"
    roles = [
      "roles/storage.objectViewer",
    ]
  },
]

# ========================================
# Cloud Storage Buckets
# ========================================

buckets = [
  {
    name                     = "app-test-bucket"
    location                 = "asia-southeast1"
    storage_class            = "STANDARD"
    public_access_prevention = "enforced"
    versioning_enabled       = true
    lifecycle_rules = [
      {
        action    = { type = "SetStorageClass", storage_class = "NEARLINE" }
        condition = { age = 30 }
      },
      {
        action    = { type = "SetStorageClass", storage_class = "COLDLINE" }
        condition = { age = 90 }
      },
      {
        action    = { type = "Delete" }
        condition = { age = 365 }
      }
    ]
  }
]

# ========================================
# Compute Engine - VM Instances
# ========================================
# Instances reference VPCs and subnets by name.

instances = [
  {
    name          = "app-server-1"
    machine_type  = "e2-custom-1-2048"
    region        = "asia-southeast1"
    zone          = "asia-southeast1-b"
    network_tags  = ["app-server", "ssh-enabled"]
    external_ip   = false # Private instance
    image_family  = "ubuntu-2404-lts-amd64"
    image_project = "ubuntu-os-cloud"
    disk_size     = 50
    disk_type     = "pd-standard"
    network       = "my-project-vpc" # Must match a network name
    subnetwork    = "app-subnet" # Must match a subnet name in the network
  },
  {
    name                = "web-server-1"
    machine_type        = "e2-custom-2-4096"
    region              = "asia-southeast1"
    zone                = "asia-southeast1-a"
    network_tags        = ["web-server", "ssh-enabled"]
    external_ip         = true
    image_family        = "ubuntu-2404-lts-amd64"
    image_project       = "ubuntu-os-cloud"
    disk_size           = 100
    disk_type           = "pd-balanced"
    network             = "my-project-vpc"
    subnetwork          = "web-subnet"
    startup_script_file = "../../scripts/install-docker.sh"
    preemptible         = false
    deletion_protection = true
  },
]

# ========================================
# Instance Groups
# ========================================

instance_groups = [
  {
    name        = "web-servers-group-a"
    description = "Instance group for web servers in zone a"
    zone        = "asia-southeast1-a"
    instances   = ["web-server-1"]
    named_ports = [
      { name = "http", port = 80 },
      { name = "https", port = 443 }
    ]
  },
  {
    name        = "app-servers-group-b"
    description = "Instance group for app servers in zone b"
    zone        = "asia-southeast1-b"
    instances   = ["app-server-1"]
    named_ports = [
      { name = "api-1", port = 8000 },
      { name = "api-2", port = 8080 }
    ]
  }
]

# ========================================
# Load Balancers
# ========================================

load_balancers = [
  # Example 1: HTTP + HTTPS Load Balancer with managed SSL
  {
    name                = "web-lb"
    description         = "Load balancer for web traffic"
    global_address_name = "web-lb-ip"
    http_port           = 80
    https_port          = 443

    health_check = {
      name                = "web-health-check"
      check_interval_sec  = 10
      timeout_sec         = 5
      healthy_threshold   = 2
      unhealthy_threshold = 3
      port                = 80
    }

    backend_service = {
      name             = "web-backend"
      protocol         = "HTTP"
      port_name        = "http"
      timeout_sec      = 30
      enable_cdn       = false
      session_affinity = "CLIENT_IP" # Options: NONE, CLIENT_IP, CLIENT_IP_PROTO
      security_policy  = null        # Cloud Armor policy name (optional)
      enable_logging   = false
      log_sample_rate  = 0.5

      # Choose one balancing mode:
      # Option 1: RATE-based
      balancing_mode        = "RATE"
      max_rate_per_instance = 1000

      # Option 2: UTILIZATION-based (uncomment to use)
      # balancing_mode  = "UTILIZATION"
      # max_utilization = 0.8

      instance_groups = [
        "web-servers-group-a"
      ]
    }

    ssl_config = {
      enabled             = true
      certificate_domains = ["www.example.com"] # GCP-managed certificate
      # For self-managed certificates:
      # private_key  = file("path/to/key.pem")
      # certificate  = file("path/to/cert.pem")
    }
  },

  # Example 2: HTTP-only Load Balancer on custom port
  {
    name                = "api-lb"
    description         = "Load balancer for API traffic"
    global_address_name = "web-lb-ip" # Can share the same IP
    http_port           = 8000

    health_check = {
      name                = "api-health-check"
      check_interval_sec  = 5
      timeout_sec         = 5
      healthy_threshold   = 2
      unhealthy_threshold = 2
      port                = 8000
    }

    backend_service = {
      name             = "api-backend"
      protocol         = "HTTP"
      port_name        = "api-1"
      timeout_sec      = 60
      enable_cdn       = false
      session_affinity = "NONE"
      security_policy  = null
      enable_logging   = false
      log_sample_rate  = 0.1

      balancing_mode  = "UTILIZATION"
      max_utilization = 0.8

      instance_groups = [
        "app-servers-group-b"
      ]
    }
  }
]
